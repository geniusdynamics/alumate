APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sentry Configuration
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE="${APP_VERSION}"
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Homepage Monitoring Configuration
HOMEPAGE_MONITORING_ENABLED=true
HOMEPAGE_PERFORMANCE_MONITORING=true
HOMEPAGE_ERROR_TRACKING=true
HOMEPAGE_UPTIME_MONITORING=true
HOMEPAGE_SECURITY_MONITORING=true
HOMEPAGE_CONVERSION_MONITORING=true

# Performance Thresholds (milliseconds)
HOMEPAGE_PAGE_LOAD_WARNING=2000
HOMEPAGE_PAGE_LOAD_CRITICAL=5000
HOMEPAGE_API_WARNING=1000
HOMEPAGE_API_CRITICAL=3000
HOMEPAGE_DB_WARNING=500
HOMEPAGE_DB_CRITICAL=2000

# Conversion Thresholds (percentages)
HOMEPAGE_CONVERSION_MIN=2.0
HOMEPAGE_CONVERSION_MAX=15.0
HOMEPAGE_CTA_CLICK_MIN=5.0
HOMEPAGE_CTA_CLICK_MAX=25.0
HOMEPAGE_BOUNCE_RATE_MAX=70.0

# Security Rate Limits
HOMEPAGE_API_RATE_LIMIT=30
HOMEPAGE_PAGE_RATE_LIMIT=60
HOMEPAGE_SUSPICIOUS_THRESHOLD=50
HOMEPAGE_DDOS_THRESHOLD=100

# Alert Configuration
MONITORING_ALERT_EMAIL=
MONITORING_SLACK_WEBHOOK=
PAGERDUTY_INTEGRATION_KEY=
DATADOG_API_KEY=
NEWRELIC_API_KEY=

# Alert Rate Limits (seconds)
HOMEPAGE_ALERT_CRITICAL_LIMIT=300
HOMEPAGE_ALERT_ERROR_LIMIT=900
HOMEPAGE_ALERT_WARNING_LIMIT=1800
HOMEPAGE_ALERT_INFO_LIMIT=3600

# Health Check Configuration
HOMEPAGE_HEALTH_CHECKS=true
HOMEPAGE_HEALTH_CHECK_INTERVAL=300
HOMEPAGE_HEALTH_CHECK_TIMEOUT=10

# Data Retention (days)
HOMEPAGE_PERFORMANCE_RETENTION=30
HOMEPAGE_ERROR_RETENTION=90
HOMEPAGE_ANALYTICS_RETENTION=365
HOMEPAGE_ALERT_RETENTION=180

# GDPR Encryption Configuration
GDPR_ENCRYPTION_KEY=
GDPR_IV=

# CRM Integration Configuration
HUBSPOT_API_KEY=your_hubspot_api_key_here
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_INSTANCE_URL=https://yourinstance.salesforce.com
FRAPPE_API_KEY=your_frappe_api_key
FRAPPE_API_SECRET=your_frappe_api_secret
FRAPPE_BASE_URL=https://yourinstance.frappe.cloud
ZOHOCRM_CLIENT_ID=your_zoho_client_id
ZOHOCRM_CLIENT_SECRET=your_zoho_client_secret

# Career Prediction AI Configuration (Optional)
CAREER_PREDICTION_API_URL=https://api.careerprediction.example.com
CAREER_PREDICTION_API_KEY=your_career_prediction_api_key

# Google Analytics Configuration
GA_MEASUREMENT_ID=your_google_analytics_measurement_id
GA_PROPERTY_ID=your_google_analytics_property_id
GA_API_SECRET=your_google_analytics_api_secret
GA_SERVICE_ACCOUNT_JSON=your_google_service_account_json
GA_SERVICE_ACCOUNT_KEY_FILE=your_google_service_account_key_file
GA_TIMEOUT=10
GA_CONNECT_TIMEOUT=5

# Matomo Configuration
MATOMO_URL=https://your-matomo-instance.com
MATOMO_SITE_ID=1
MATOMO_TOKEN_AUTH=your_matomo_token_auth
MATOMO_TIMEOUT=10
MATOMO_CONNECT_TIMEOUT=5

# Privacy Compliance Configuration
PRIVACY_AUDIT_RETENTION_DAYS=365
CCPA_OPT_OUT_ENABLED=true

# Learning Analytics Configuration
LEARNING_ENGAGEMENT_WEIGHT_DURATION=0.4
LEARNING_ENGAGEMENT_WEIGHT_INTERACTIONS=0.3
LEARNING_ENGAGEMENT_WEIGHT_COMPLETION=0.3
LEARNING_CACHE_TTL=60
LEARNING_BATCH_SIZE=100
LEARNING_MAX_ENGAGEMENT_DURATION=600
LEARNING_MAX_INTERACTIONS=100

# Production Scaling Configuration
HORIZON_WORKERS=20
REDIS_CLUSTER=true

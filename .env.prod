APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=your_production_database
DB_USERNAME=your_production_username
DB_PASSWORD=your_secure_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

PUSHER_APP_ID=prod_pusher_app_id
PUSHER_APP_KEY=prod_pusher_app_key
PUSHER_APP_SECRET=prod_pusher_app_secret
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=prod-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sentry Configuration
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE="${APP_VERSION}"
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Homepage Monitoring Configuration
HOMEPAGE_MONITORING_ENABLED=true
HOMEPAGE_PERFORMANCE_MONITORING=true
HOMEPAGE_ERROR_TRACKING=true
HOMEPAGE_UPTIME_MONITORING=true
HOMEPAGE_SECURITY_MONITORING=true
HOMEPAGE_CONVERSION_MONITORING=true

# Performance Thresholds (milliseconds)
HOMEPAGE_PAGE_LOAD_WARNING=2000
HOMEPAGE_PAGE_LOAD_CRITICAL=5000
HOMEPAGE_API_WARNING=1000
HOMEPAGE_API_CRITICAL=3000
HOMEPAGE_DB_WARNING=500
HOMEPAGE_DB_CRITICAL=2000

# Conversion Thresholds (percentages)
HOMEPAGE_CONVERSION_MIN=2.0
HOMEPAGE_CONVERSION_MAX=15.0
HOMEPAGE_CTA_CLICK_MIN=5.0
HOMEPAGE_CTA_CLICK_MAX=25.0
HOMEPAGE_BOUNCE_RATE_MAX=70.0

# Security Rate Limits
HOMEPAGE_API_RATE_LIMIT=30
HOMEPAGE_PAGE_RATE_LIMIT=60
HOMEPAGE_SUSPICIOUS_THRESHOLD=50
HOMEPAGE_DDOS_THRESHOLD=100

# Alert Configuration
MONITORING_ALERT_EMAIL=alerts@yourdomain.com
MONITORING_SLACK_WEBHOOK=https://hooks.slack.com/services/your/slack/webhook
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_key
DATADOG_API_KEY=your_datadog_api_key
NEWRELIC_API_KEY=your_newrelic_api_key

# Alert Rate Limits (seconds)
HOMEPAGE_ALERT_CRITICAL_LIMIT=300
HOMEPAGE_ALERT_ERROR_LIMIT=900
HOMEPAGE_ALERT_WARNING_LIMIT=1800
HOMEPAGE_ALERT_INFO_LIMIT=3600

# Health Check Configuration
HOMEPAGE_HEALTH_CHECKS=true
HOMEPAGE_HEALTH_CHECK_INTERVAL=300
HOMEPAGE_HEALTH_CHECK_TIMEOUT=10

# Data Retention (days)
HOMEPAGE_PERFORMANCE_RETENTION=30
HOMEPAGE_ERROR_RETENTION=90
HOMEPAGE_ANALYTICS_RETENTION=365
HOMEPAGE_ALERT_RETENTION=180

# GDPR Encryption Configuration
GDPR_ENCRYPTION_KEY=your_gdpr_encryption_key
GDPR_IV=your_gdpr_iv

# CRM Integration Configuration
HUBSPOT_API_KEY=your_hubspot_api_key_here
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_INSTANCE_URL=https://yourinstance.salesforce.com
FRAPPE_API_KEY=your_frappe_api_key
FRAPPE_API_SECRET=your_frappe_api_secret
FRAPPE_BASE_URL=https://yourinstance.frappe.cloud
ZOHOCRM_CLIENT_ID=your_zoho_client_id
ZOHOCRM_CLIENT_SECRET=your_zoho_client_secret

# Career Prediction AI Configuration (Optional)
CAREER_PREDICTION_API_URL=https://api.careerprediction.example.com
CAREER_PREDICTION_API_KEY=your_career_prediction_api_key

# Horizon Configuration
HORIZON_PREFIX=prod-analytics

# New Relic Configuration
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# Google Analytics Configuration
GOOGLE_ANALYTICS_TRACKING_ID=your_ga_tracking_id
GOOGLE_ANALYTICS_API_KEY=your_ga_api_key

# Matomo Configuration
MATOMO_SITE_ID=your_matomo_site_id
MATOMO_API_KEY=your_matomo_api_key
MATOMO_BASE_URL=https://your-matomo-instance.com

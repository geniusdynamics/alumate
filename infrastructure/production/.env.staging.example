# Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

# Application
APP_NAME="Alumate Staging"
APP_ENV=staging
APP_DEBUG=true
APP_KEY=base64:your-staging-app-key-here
APP_URL=https://staging.your-domain.com

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=staging_db
DB_USERNAME=staging_user
DB_PASSWORD=your-staging-db-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your-staging-redis-password
REDIS_PORT=6379

# Multi-tenancy
TENANCY_ENABLED=true
TENANCY_ISOLATE_DATA=true
TENANT_DEFAULT_DOMAIN=staging.your-domain.com

# Storage
FILESYSTEM_DISK=local
# AWS S3 (optional)
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_BUCKET=your-bucket
# AWS_REGION=us-east-1

# Session
SESSION_DRIVER=redis
SESSION_DOMAIN=.staging.your-domain.com

# Cache
CACHE_DRIVER=redis

# Queue
QUEUE_CONNECTION=redis

# Mail (optional)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@staging.your-domain.com
# MAIL_FROM_NAME="${APP_NAME}"

# Monitoring
SENTRY_ENABLED=false
# SENTRY_DSN=https://your-sentry-dsn

# New Relic (optional)
# NEW_RELIC_ENABLED=true
# NEW_RELIC_APP_NAME=Alumate Staging
# NEW_RELIC_LICENSE_KEY=your-license-key

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Backup
BACKUP_ENABLED=true
BACKUP_PROVIDER=local
BACKUP_RETENTION_DAYS=7

# SSL
SSL_ENABLED=true
# SSL_CERT_PATH=/etc/letsencrypt/live/staging.your-domain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/staging.your-domain.com/privkey.pem

# Rate Limiting
RATE_LIMITER_MAX_ATTEMPTS=60
RATE_LIMITER_DECAY_MINUTES=1

# API
API_PREFIX=api/v1
API_VERSION=v1

# Debug (development features)
DEBUGBAR_ENABLED=true
IDE_HELPER_ENABLED=true

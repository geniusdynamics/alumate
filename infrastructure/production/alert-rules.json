{
  "version": "3.0.0",
  "name": "Alumate Production Alert Rules",
  "description": "Comprehensive alert rules for Alumate production monitoring system",
  "last_updated": "2024-09-01T00:00:00Z",
  "updated_by": "platform-team",
  "enabled": true,
  "severity_levels": {
    "critical": {
      "priority": 1,
      "color": "#FF0000",
      "icon": "🚨",
      "auto_escalate": true,
      "notify_immediately": true,
      "sla_minutes": 15
    },
    "high": {
      "priority": 2,
      "color": "#FF6B00",
      "icon": "⚠️",
      "auto_escalate": true,
      "notify_immediately": true,
      "sla_minutes": 30
    },
    "medium": {
      "priority": 3,
      "color": "#FFC000",
      "icon": "⚡",
      "auto_escalate": false,
      "notify_immediately": false,
      "sla_minutes": 120
    },
    "low": {
      "priority": 4,
      "color": "#00B0F0",
      "icon": "ℹ️",
      "auto_escalate": false,
      "notify_immediately": false,
      "sla_minutes": 480
    },
    "info": {
      "priority": 5,
      "color": "#70AD47",
      "icon": "✅",
      "auto_escalate": false,
      "notify_immediately": false,
      "sla_minutes": null
    }
  },
  "alert_groups": {
    "infrastructure": {
      "description": "Infrastructure and system resource alerts",
      "order": 1,
      "alerts": [
        {
          "id": "INF-001",
          "name": "Application Unavailable",
          "description": "Application is not responding to health checks",
          "severity": "critical",
          "condition": {
            "type": "health_check",
            "metric": "application_health",
            "operator": "eq",
            "value": "unhealthy"
          },
          "evaluation_window": "1m",
          "evaluation_interval": "30s",
          "channels": ["email", "slack", "pagerduty", "sms", "phone"],
          "runbook": "https://wiki.alumate.com/runbooks/application-down",
          "auto_resolve": false,
          "tags": ["infrastructure", "application", "availability"]
        },
        {
          "id": "INF-002",
          "name": "High Memory Usage",
          "description": "Memory usage has exceeded critical threshold",
          "severity": "critical",
          "condition": {
            "type": "percentage",
            "metric": "memory_usage",
            "operator": "gte",
            "value": 95
          },
          "evaluation_window": "5m",
          "evaluation_interval": "60s",
          "channels": ["email", "slack", "pagerduty"],
          "runbook": "https://wiki.alumate.com/runbooks/memory-critical",
          "auto_resolve": true,
          "tags": ["infrastructure", "memory", "performance"]
        },
        {
          "id": "INF-003",
          "name": "High CPU Usage",
          "description": "CPU usage has exceeded critical threshold",
          "severity": "high",
          "condition": {
            "type": "percentage",
            "metric": "cpu_usage",
            "operator": "gte",
            "value": 90
          },
          "evaluation_window": "5m",
          "evaluation_interval": "60s",
          "channels": ["email", "slack"],
          "runbook": "https://wiki.alumate.com/runbooks/cpu-high",
          "auto_resolve": true,
          "tags": ["infrastructure", "cpu", "performance"]
        },
        {
          "id": "INF-004",
          "name": "Disk Space Critical",
          "description": "Disk space usage has exceeded critical threshold",
          "severity": "critical",
          "condition": {
            "type": "percentage",
            "metric": "disk_usage",
            "operator": "gte",
            "value": 95
          },
          "evaluation_window": "5m",
          "evaluation_interval": "60s",
          "channels": ["email", "slack", "pagerduty"],
          "runbook": "https://wiki.alumate.com/runbooks/disk-critical",
          "auto_resolve": false,
          "tags": ["infrastructure", "storage", "disk"]
        },
        {
          "id": "INF-005",
          "name": "Disk Space Warning",
          "description": "Disk space usage has exceeded warning threshold",
          "severity": "medium",
          "condition": {
            "type": "percentage",
            "metric": "disk_usage",
            "operator": "gte",
            "value": 80
          },
          "evaluation_window": "10m",
          "evaluation_interval": "300s",
          "channels": ["email", "slack"],
          "runbook": "https://wiki.alumate.com/runbooks/disk-warning",
          "auto_resolve": false,
          "tags": ["infrastructure", "storage", "disk"]
        },
        {
          "id": "INF-006",
          "name": "Container Restart Loop",
          "description": "Container has restarted multiple times in short period",
          "severity": "high",
          "condition": {
            "type": "count",
            "metric": "container_restarts",
            "operator": "gte",
            "value": 3
          },
          "evaluation_window": "15m",
          "evaluation_interval": "60s",
          "channels": ["email", "slack", "pagerduty"],
          "runbook": "https://wiki.alumate.com/runbooks/container-restarts",
          "auto_resolve": false,
          "tags": ["infrastructure", "container", "stability"]
        }
      ]
    },

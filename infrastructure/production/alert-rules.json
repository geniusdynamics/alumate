          "name": "Scheduled Maintenance",
          "description": "Upcoming scheduled maintenance window",
          "severity": "info",
          "condition": {
            "type": "scheduled",
            "metric": "maintenance_window",
            "operator": "eq",
            "value": "upcoming"
          },
          "evaluation_window": "1d",
          "evaluation_interval": "3600s",
          "channels": ["email", "slack"],
          "runbook": "https://wiki.alumate.com/runbooks/maintenance",

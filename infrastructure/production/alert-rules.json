    "backup": {
      "description": "Backup and recovery alerts",
      "order": 9,
      "alerts": [
        {
          "id": "BACKUP-001",
          "name": "Backup Failed",
          "description": "Scheduled backup failed to complete",
          "severity": "high",
          "condition": {
            "type": "event",
            "metric": "backup_status",
            "operator": "eq",
            "value": "failed"
          },
          "evaluation_window": "1h",
          "evaluation_interval": "60s",
          "channels": ["email", "slack"],
          "runbook": "https://wiki.alumate.com/runbooks/backup-failed",
          "auto_resolve": false,
          "tags": ["backup", "recovery", "data-protection"]
        },
        {
          "id": "BACKUP-002",
          "name": "Backup Overdue",
          "description": "Expected backup has not completed",
          "severity": "medium",
          "condition": {
            "type": "hours",
            "metric": "time_since_last_backup",
            "operator": "gte",
            "value": 26
          },
          "evaluation_window": "1h",
          "evaluation_interval": "300s",
          "channels": ["email", "slack"],
          "runbook": "https://wiki.alumate.com/runbooks/backup-overdue",
          "auto_resolve": false,
          "tags": ["backup", "recovery", "data-protection"]
        },
        {

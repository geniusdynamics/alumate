# ============================================================================
# ALUMATE PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.production and fill in your production values
# This file contains all environment variables for production deployment
# ============================================================================
# Last Updated: 2024-02-05
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

APP_NAME="Alumni Platform"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your-32-character-app-key-here
APP_URL=https://your-production-domain.com
APP_VERSION=2.0.0
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_MAX_FILES=30
LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

CACHE_DRIVER=redis
CACHE_STORE=redis
CACHE_PREFIX=alumate_cache_

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PREFIX=alumate_sess_
SESSION_COOKIE=alumate_session

# ============================================================================
# QUEUE CONFIGURATION
# ============================================================================

QUEUE_CONNECTION=redis
QUEUE_PREFIX=alumate_queue_
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_MAX_TRIES=3
QUEUE_WORKER_TIMEOUT=90

# ============================================================================
# FILE SYSTEM
# ============================================================================

FILESYSTEM_DISK=s3
STORAGE_PREFIX=alumate_storage_

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

DB_CONNECTION=pgsql
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_DATABASE=alumni_platform
DB_USERNAME=prod_db_user
DB_PASSWORD=your-secure-db-password
DB_CHARSET=utf8
DB_PREFIX=
DB_SCHEMA=public
DB_SSLMODE=require

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=your-redis-host.example.com
REDIS_PASSWORD=your-secure-redis-password
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=alumate_
REDIS_CLUSTER=false

# ============================================================================
# MULTI-TENANCY CONFIGURATION
# ============================================================================

TENANCY_ENABLED=true
TENANCY_DATABASE_AUTO_DELETE_ENABLED=false
TENANCY_DATABASE_AUTO_CLEANUP=false
TENANCY_ISOLATE_DATA=true
TENANCY_DEFAULT_DOMAIN=alumni-platform.com

# ============================================================================
# MAIL CONFIGURATION (SMTP)
# ============================================================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-production-domain.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=your-production-domain.com

# ============================================================================
# AWS S3 CONFIGURATION
# ============================================================================

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-production-bucket-name
AWS_ENDPOINT=https://s3.amazonaws.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# THIRD-PARTY SERVICES - OAUTH
# ============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-production-domain.com/auth/google/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=https://your-production-domain.com/auth/facebook/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://your-production-domain.com/auth/linkedin/callback

# ============================================================================
# THIRD-PARTY SERVICES - ANALYTICS
# ============================================================================

# Matomo Analytics
MATOMO_URL=https://your-matomo-instance.com
MATOMO_SITE_ID=1
MATOMO_TOKEN=your-matomo-api-token

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=your-ga-property-id
GA_API_SECRET=your-ga-api-secret

# ============================================================================
# CRM INTEGRATION
# ============================================================================

HUBSPOT_API_KEY=your-hubspot-api-key
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_INSTANCE_URL=https://yourinstance.salesforce.com
ZOHOCRM_CLIENT_ID=your-zoho-client-id
ZOHOCRM_CLIENT_SECRET=your-zoho-client-secret

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Application Performance Monitoring
APM_ENABLED=true
APM_APP_NAME="${APP_NAME}"
APM_ENVIRONMENT="${APP_ENV}"

# Sentry Error Tracking
SENTRY_ENABLED=true
SENTRY_LARAVEL_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE="${APP_VERSION}"
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# New Relic
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME="${APP_NAME}"
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# Datadog
DATADOG_ENABLED=false
DATADOG_SERVICE="${APP_NAME}"
DATADOG_ENV="${APP_ENV}"
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126

# ============================================================================
# ALERTING & NOTIFICATIONS
# ============================================================================

# Alert Channels
ALERTS_ENABLED=true
ALERT_EMAIL_ENABLED=true
ALERT_SLACK_ENABLED=false
ALERT_PAGERDUTY_ENABLED=false
ALERT_WEBHOOK_ENABLED=false

# Alert Recipients
ALERT_EMAIL_RECIPIENTS=admin@your-production-domain.com,ops@your-production-domain.com
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
ALERT_PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key

# Alert Thresholds
ALERT_MEMORY_WARNING=128
ALERT_MEMORY_CRITICAL=256
ALERT_RESPONSE_WARNING=500
ALERT_RESPONSE_CRITICAL=1000
ALERT_ERROR_WARNING=1.0
ALERT_ERROR_CRITICAL=5.0

# Alert Cooldowns (in seconds)
ALERT_COOLDOWN_LOW=300
ALERT_COOLDOWN_MEDIUM=1800
ALERT_COOLDOWN_HIGH=3600
ALERT_COOLDOWN_CRITICAL=7200

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Password hashing
PASSWORD_HASH=bcrypt
PASSWORD_ROUNDS=12

# Two-Factor Authentication
2FA_ENABLED=true
2FA_FORCE=false

# Rate Limiting
RATE_LIMITER_MAX_ATTEMPTS=5
RATE_LIMITER_DECAY_MINUTES=1

# CSRF Protection
CSRF_PROTECTION=true

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_PROVIDER=aws_s3
BACKUP_STORAGE_DISK=local
BACKUP_SCHEDULE=0 1 * * *
BACKUP_COMPRESSION=lz4
BACKUP_ENCRYPTION=true

# Retention Policies (in days)
BACKUP_RETENTION_DATABASE=30
BACKUP_RETENTION_FILES=90
BACKUP_RETENTION_CONFIG=365
BACKUP_MAX_AGE_DAYS=90
BACKUP_MAX_COUNT=100
BACKUP_KEEP_CRITICAL=true

# Backup Verification
BACKUP_VERIFICATION_ENABLED=true
BACKUP_CHECKSUM_ALGORITHM=sha256
BACKUP_MIN_SIZE_BYTES=1024

# Backup Notifications
BACKUP_NOTIFICATIONS_ENABLED=true
BACKUP_NOTIFY_ON_SUCCESS=true
BACKUP_NOTIFY_ON_FAILURE=true
BACKUP_NOTIFICATION_CHANNELS=mail

# AWS S3 Backup Bucket
BACKUP_AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
BACKUP_AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
BACKUP_AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION}
BACKUP_AWS_BUCKET=your-backup-bucket-name
BACKUP_AWS_STORAGE_CLASS=STANDARD_IA

# Google Cloud Storage (alternative)
BACKUP_GCP_PROJECT_ID=your-gcp-project-id
BACKUP_GCS_BUCKET=your-backup-bucket-name

# Azure Blob Storage (alternative)
BACKUP_AZURE_CONTAINER=backups
BACKUP_AZURE_ACCOUNT=your-azure-account
BACKUP_AZURE_KEY=your-azure-key

# ============================================================================
# MAINTENANCE & CLEANUP
# ============================================================================

# Data Retention
DATA_RETENTION_DAYS=365
ANALYTICS_DATA_RETENTION_DAYS=90
LOGS_RETENTION_DAYS=90

# GDPR Compliance
GDPR_COMPLIANCE_MODE=true
DATA_ANONYMIZE_AFTER_DAYS=90
GDPR_ENCRYPTION_KEY=your-gdpr-encryption-key
GDPR_IV=your-gdpr-iv

# ============================================================================
# CRON JOBS & SCHEDULING
# ============================================================================

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# PHP-FPM
PHP_FPM_PM=dynamic
PHP_FPM_PM_MAX_CHILDREN=10
PHP_FPM_PM_START_SERVERS=2
PHP_FPM_PM_MIN_SPARE_SERVERS=1
PHP_FPM_PM_MAX_SPARE_SERVERS=5
PHP_FPM_PM_MAX_REQUESTS=500

# Redis Connection Pool
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=10

# Horizon Configuration
HORIZON_PREFIX=prod-analytics
HORIZON_WORKERS=20

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_NOTIFICATIONS=true
FEATURE_SEARCH=true
FEATURE_WEBHOOKS=true
FEATURE_BATCH_OPERATIONS=true
FEATURE_IMPORT_EXPORT=true

# Analytics Cache
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_TTL=300
ANALYTICS_CACHE_STORE=redis

# Analytics Snapshots
ANALYTICS_SNAPSHOTS_ENABLED=true
ANALYTICS_SNAPSHOTS_RETENTION=365

# Analytics Performance
ANALYTICS_QUERY_TIMEOUT=60
ANALYTICS_MEMORY_LIMIT=512M
ANALYTICS_CHUNK_SIZE=1000

# Analytics Security
ANALYTICS_ANONYMIZE_DATA=false
ANALYTICS_RATE_LIMITING=true
ANALYTICS_MAX_REQUESTS_PER_MINUTE=60

# ============================================================================
# HOMEPAGE MONITORING
# ============================================================================

HOMEPAGE_MONITORING_ENABLED=true
HOMEPAGE_PERFORMANCE_MONITORING=true
HOMEPAGE_ERROR_TRACKING=true
HOMEPAGE_UPTIME_MONITORING=true
HOMEPAGE_SECURITY_MONITORING=true
HOMEPAGE_CONVERSION_MONITORING=true

# Performance Thresholds (milliseconds)
HOMEPAGE_PAGE_LOAD_WARNING=2000
HOMEPAGE_PAGE_LOAD_CRITICAL=5000
HOMEPAGE_API_WARNING=1000
HOMEPAGE_API_CRITICAL=3000
HOMEPAGE_DB_WARNING=500
HOMEPAGE_DB_CRITICAL=2000

# Security Rate Limits
HOMEPAGE_API_RATE_LIMIT=30
HOMEPAGE_PAGE_RATE_LIMIT=60
HOMEPAGE_SUSPICIOUS_THRESHOLD=50
HOMEPAGE_DDOS_THRESHOLD=100

# ============================================================================
# HEALTH CHECKS
# ============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# ============================================================================
# INFRASTRUCTURE SETTINGS
# ============================================================================

# Container Configuration
CONTAINER_MEMORY_LIMIT=512M
CONTAINER_CPU_LIMIT=1.0

# ============================================================================
# DEBUG & DEVELOPMENT (DO NOT ENABLE IN PRODUCTION)
# ============================================================================

# These should ALWAYS be false in production
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
LOG_QUERIES=false
LOG_SLOW_QUERIES=false
SLOW_QUERY_THRESHOLD=1000

# ============================================================================
# CUSTOM CONFIGURATION
# ============================================================================

# Add any custom environment variables below
# CUSTOM_SETTING_1=value
# CUSTOM_SETTING_2=value

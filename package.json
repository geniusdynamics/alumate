{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:ssr": "vite build && vite build --ssr",
    "dev": "vite",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "lint": "eslint . --fix",
    "lint:imports-case": "node scripts/frontend/check-import-case.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:homepage": "vitest run --reporter=verbose tests/Js/homepage",
    "test:smoke": "vitest run --reporter=verbose tests/Js/smoke",
    "analyze": "vite build --mode analyze",
    "analyze:bundle": "vite-bundle-analyzer dist",
    "build:analyze": "npm run build && npm run analyze:bundle",
    "perf:test": "vitest run tests/Performance --reporter=verbose",
    "perf:lighthouse": "lighthouse http://localhost:8080 --output=html --output-path=./reports/lighthouse.html"
  },

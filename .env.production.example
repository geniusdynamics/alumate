# Production Environment Configuration for Unified Platform Deployment

APP_NAME="Alumni Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com
APP_VERSION=2.0.0

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=production-db-host
DB_PORT=5432
DB_DATABASE=alumni_platform_production
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_SCHEMA=public
DB_CHARSET=utf8

# Read/Write Database Replicas
DB_READ_HOST=production-db-read-replica
DB_WRITE_HOST=production-db-write-host

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=alumni_platform
REDIS_HOST=production-redis-host
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_SEEDS=redis-cluster-1:6379,redis-cluster-2:6379,redis-cluster-3:6379

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Homepage Deployment Configuration
HOMEPAGE_DEPLOYMENT_ENABLED=true

# SSL Configuration
SSL_ENABLED=true
SSL_CERTIFICATE_PATH=/etc/ssl/certs/your-domain.crt
SSL_PRIVATE_KEY_PATH=/etc/ssl/private/your-domain.key
FORCE_HTTPS=true

# Security Headers Configuration
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

CSP_ENABLED=true
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com;"

X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION="1; mode=block"
REFERRER_POLICY=strict-origin-when-cross-origin

# Performance Configuration
CACHE_STATIC_ASSETS=true
STATIC_CACHE_DURATION=31536000
GZIP_COMPRESSION=true
MINIFY_HTML=true
OPCACHE_ENABLED=true
JIT_ENABLED=true

# Monitoring Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
PERFORMANCE_MONITORING_ENABLED=true
ERROR_TRACKING_ENABLED=true

# New Relic Monitoring
NEW_RELIC_ENABLED=true
NEW_RELIC_APP_NAME="Alumni Platform Production"
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=https://5b2c3cb3a5eb423893d58842bbe71483@app1.genius2.mrmarkuz.ddnss.eu/1
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# CDN Configuration
CDN_ENABLED=true
CDN_URL=https://cdn.your-domain.com
CDN_ASSETS_PATH=assets
CDN_REGION=us-east-1
CDN_DISTRIBUTION_ID=

# Database Migration Configuration
MIGRATION_TIMEOUT=300
BACKUP_BEFORE_MIGRATION=true

# Analytics Configuration
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=

# Third-party Services
BUGSNAG_API_KEY=

# File Storage
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_CLOUDFRONT_URL=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single,daily,slack
LOG_LEVEL=error
LOG_SLACK_WEBHOOK_URL=
LOG_DAILY_MAX_FILES=30

# Broadcasting
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=alumate_app
PUSHER_APP_KEY=alumate_key
PUSHER_APP_SECRET=alumate_secret
PUSHER_HOST=websockets
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Vite Broadcasting
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Tenant Configuration
TENANT_DATABASE_PREFIX=tenant_
TENANT_FILESYSTEM_DISK=s3
TENANT_CACHE_PREFIX=tenant_cache_
TENANT_SESSION_DOMAIN=.your-domain.com

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=daily

# Deployment Secrets (Set in CI/CD)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_KEY=
DEPLOY_PATH=
PRODUCTION_URL=
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest